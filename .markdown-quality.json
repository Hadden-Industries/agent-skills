{
  "schemaVersion": 2,
  "preset": "authored-gfm@1",
  "include": [
    "*.md",
    "docs/**/*.md",
    "src/*/SKILL.md",
    "src/*/references/**/*.md"
  ],
  "exclude": [
    "**/*.md"
  ],
  "lint": {},
  "links": {
    "localFiles": false,
    "rootRelative": "reject"
  },
  "layout": {
    "endOfLine": "lf",
    "tabWidth": 2
  },
  "limits": {
    "documentDiagnostics": 10000,
    "diagnostics": 50000
  }
}
