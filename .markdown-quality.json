{
  "schemaVersion": 2,
  "preset": "authored-gfm@1",
  "include": ["**/*.md"],
  "exclude": ["skills/**", "plugins/**", "src/*/evals/**", "evidence/**", ".agents/**", ".claude/**", "docs/plans/**", "docs/reviews/**", "docs/designs/**", "docs/assurance-cases/**", "docs/**/reviews/**", "docs/**/issues/**", "docs/research/**", "docs/2026-*.md", ".agent-tools/**"],
  "lint": {},
  "links": { "localFiles": true, "rootRelative": "reject" },
  "layout": { "endOfLine": "lf", "tabWidth": 2 },
  "limits": { "documentDiagnostics": 10000, "diagnostics": 50000 }
}
