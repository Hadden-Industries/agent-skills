{
  "schema_version": "1.0",
  "policy_name": "naming-objects-in-software-engineering",
  "policy_version": "1.0.0",
  "generated_on": "2026-09-03",
  "character_scope": "ASCII lexical profiles. Language-valid Unicode identifiers and externally required spellings require an explicit scoped override.",
  "scope": "Deterministic lexical validation after exact artefact classification. This policy does not mechanically certify semantic correctness.",
  "governing_principle": "One concept, one canonical semantic stem per governed context; many ecosystem-correct physical designations where syntax requires them.",
  "authority_precedence": [
    "Validity-critical language, runtime, protocol, framework, build-tool, and discovery requirements.",
    "Explicit governing instructions for the organisation, repository, task, or scoped path.",
    "Official ecosystem convention, or a clearly selected style profile where no language-owned convention exists.",
    "This policy's generic fallback."
  ],
  "semantic_gate": {
    "mechanically_certified": false,
    "presumptively_vague_tokens": [
      "base",
      "common",
      "data",
      "handler",
      "helper",
      "helpers",
      "info",
      "item",
      "manager",
      "misc",
      "object",
      "processor",
      "service",
      "thing",
      "util",
      "utility",
      "utils"
    ],
    "review_questions": [
      "Does the designation identify the intended concept without opening the implementation?",
      "Does it distinguish the nearest plausible related concepts?",
      "Does every term add information at the use site?",
      "Are verb, cardinality, units, representation, side effects, and boundaries truthful where relevant?",
      "Does it use governed domain vocabulary and only standard, unambiguous abbreviations?",
      "Does the final spelling obey the rule for the exact artefact kind?"
    ],
    "warning_only": "The checker can flag vague tokens as prompts for review, but context can justify them and their absence does not prove semantic precision."
  },
