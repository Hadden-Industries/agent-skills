{
  "name": "@hadden-industries/agent-skills",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=12.2.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "format": "prettier --write \"eslint.config.js\" \"package.json\" \"scripts/**/*.js\" \"lib/**/*.js\" \"src/**/*.{js,json}\" \"tests/**/*.mjs\"",
    "format:check": "prettier --check \"eslint.config.js\" \"package.json\" \"scripts/**/*.js\" \"lib/**/*.js\" \"src/**/*.{js,json}\" \"tests/**/*.mjs\"",
    "lint": "npm run lint:js",
    "lint:js": "eslint eslint.config.js scripts lib src tests --max-warnings 0",
    "fix:all": "eslint eslint.config.js scripts lib src tests --fix && npm run format",
    "prebuild": "npm run format:check && npm run lint",
    "build": "node scripts/buildRepository.js",
    "build:check": "npm run format:check && npm run lint && node scripts/buildRepository.js --check",
    "package:plugin": "node scripts/packagePluginArchive.js",
    "test": "node --test --test-concurrency=4 \"tests/**/*.test.mjs\"",
    "skills:validate": "node scripts/validateSkills.js",
    "skills:lint": "node scripts/lintSkills.js",
    "diff:check": "git diff --check HEAD",
    "verify:skill": "node scripts/verifySkill.js",
    "eval:check": "node scripts/evaluation/check-conformance.js",
    "ci:evidence": "node scripts/ci/verificationEvidence.js",
    "check:markdown": "markdown-quality check --root .",
    "format:markdown": "markdown-quality format --write --root .",
    "inspect:markdown": "markdown-quality inspect --root . --json",
    "test:markdown": "node --test tests/scripts/markdown-quality.test.mjs",
    "verify": "npm run diff:check && npm run build:check && npm run check:markdown && npm run skills:validate && npm run skills:lint && npm run eval:check && npm test"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": ">=10.0.1",
    "@hadden-industries/markdown-quality": ">=3.0.0",
    "agent-skills-eval": ">=0.1.1",
    "ajv": ">=8.20.0",
    "cross-spawn": ">=7.0.6",
    "dependency-cruiser": ">=18.7.1",
    "esbuild": ">=0.28.2",
    "eslint": ">=10.12.0",
    "eslint-config-prettier": ">=10.1.8",
    "globals": ">=17.13.0",
    "prettier": ">=3.9.9",
    "skills": ">=1.7.2",
    "yaml": ">=2.9.1"
  }
}
