{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commit Snapshot Manifest",
  "description": "Immutable description of the Git tree approved for a commit workflow.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workflowMode",
    "scopeKind",
    "sourceIndex",
    "repositoryRoot",
    "headOid",
    "indexTreeOid",
    "indexFile",
    "temporaryObjectDirectory",
    "objectAlternates",
    "sourceIndexIdentity",
    "promotionBlocker",
    "diffPolicy",
    "changeUnitCount",
    "changeUnits",
    "statistics",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "workflowMode": { "enum": ["actual", "draft"] },
    "scopeKind": { "enum": ["staged", "full", "paths"] },
    "sourceIndex": { "enum": ["real", "temporary"] },
    "repositoryRoot": { "type": "string", "minLength": 1 },
    "headOid": { "type": ["string", "null"] },
    "indexTreeOid": { "type": "string", "minLength": 1 },
    "indexFile": { "type": ["string", "null"] },
    "temporaryObjectDirectory": { "type": ["string", "null"] },
    "objectAlternates": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "sourceIndexIdentity": { "$ref": "#/$defs/indexIdentity" },
    "promotionBlocker": {
      "oneOf": [{ "const": null }, { "$ref": "#/$defs/promotionBlocker" }]
    },
    "diffPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renameScore",
        "copyDetection",
        "renameLimit",
        "externalDiff",
        "textconv",
        "rename",
        "lineStatistics"
      ],
      "properties": {
        "renameScore": { "type": "integer", "minimum": 0 },
        "copyDetection": { "const": false },
        "renameLimit": { "type": "integer", "minimum": 0 },
        "externalDiff": { "const": false },
        "textconv": { "const": false },
        "rename": { "$ref": "#/$defs/renamePolicy" },
        "lineStatistics": { "$ref": "#/$defs/lineStatisticsPolicy" }
      }
    },
    "changeUnitCount": { "type": "integer", "minimum": 0 },
    "changeUnits": {
      "type": "array",
      "items": { "$ref": "#/$defs/changeUnit" }
    },
    "statistics": { "$ref": "#/$defs/statistics" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "nullableInteger": { "type": ["integer", "null"] },
    "changeUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "sourcePath",
        "destinationPath",
        "path",
        "sourcePathBytesBase64",
        "destinationPathBytesBase64",
        "displayPath",
        "oldMode",
        "newMode",
        "oldOid",
        "newOid",
        "similarity",
        "renameClassification",
        "lineStatistics",
        "binary",
        "additions",
        "deletions",
        "stageablePaths",
        "inspectionUnitIds"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed",
            "mode-changed",
            "symlink-changed",
            "type-changed",
            "submodule-changed"
          ]
        },
        "sourcePath": { "$ref": "#/$defs/nullableString" },
        "destinationPath": { "type": "string" },
        "path": { "$ref": "#/$defs/nullableString" },
        "sourcePathBytesBase64": { "$ref": "#/$defs/nullableString" },
        "destinationPathBytesBase64": { "type": "string" },
        "displayPath": { "type": "string" },
        "oldMode": { "type": "string" },
        "newMode": { "type": "string" },
        "oldOid": { "type": "string" },
        "newOid": { "type": "string" },
        "similarity": { "$ref": "#/$defs/nullableInteger" },
        "renameClassification": {
          "enum": ["exact-object", "similarity", "exact-rename-ambiguous", null]
        },
        "lineStatistics": { "enum": ["eager", "deferred"] },
        "binary": { "type": ["boolean", "null"] },
        "additions": { "$ref": "#/$defs/nullableInteger" },
        "deletions": { "$ref": "#/$defs/nullableInteger" },
        "stageablePaths": { "type": "array", "items": { "type": "string" } },
        "inspectionUnitIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "additions", "deletions", "binaryFiles"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "additions": { "type": ["integer", "null"], "minimum": 0 },
        "deletions": { "type": ["integer", "null"], "minimum": 0 },
        "binaryFiles": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "quantity": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)$" }
      ]
    },
    "renamePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "maximumCandidatePairs",
        "addedCandidates",
        "deletedCandidates",
        "candidatePairs"
      ],
      "properties": {
        "mode": { "enum": ["eager", "deferred"] },
        "maximumCandidatePairs": { "$ref": "#/$defs/quantity" },
        "addedCandidates": { "type": "integer", "minimum": 0 },
        "deletedCandidates": { "type": "integer", "minimum": 0 },
        "candidatePairs": { "$ref": "#/$defs/quantity" }
      }
    },
    "lineStatisticsPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "maximumEagerBytes", "eligibleBlobBytes"],
      "properties": {
        "mode": { "enum": ["eager", "deferred"] },
        "maximumEagerBytes": { "$ref": "#/$defs/quantity" },
        "eligibleBlobBytes": { "$ref": "#/$defs/quantity" }
      }
    },
    "indexIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": { "state": { "const": "absent" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "byteCount", "sha256"],
          "properties": {
            "state": { "const": "file" },
            "byteCount": { "type": "integer", "minimum": 0 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      ]
    },
    "promotionBlocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "realIndexSha256",
        "stagedChangeUnitCount",
        "samples"
      ],
      "properties": {
        "kind": { "const": "real-staged-changes" },
        "realIndexSha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "stagedChangeUnitCount": { "type": "integer", "minimum": 1 },
        "samples": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
