{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commit Signature Verification History",
  "description": "Policy transitions and backend-specific identity results for one exact commit OID.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "commitOid",
    "initialPolicy",
    "finalPolicy",
    "attempts",
    "effectiveAttempt",
    "blocksPush"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "commitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "initialPolicy": { "$ref": "#/$defs/policy" },
    "finalPolicy": { "$ref": "#/$defs/policy" },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/attempt" }
    },
    "effectiveAttempt": { "type": "integer", "minimum": 0 },
    "blocksPush": { "type": "boolean" }
  },
  "$defs": {
    "policy": { "enum": ["required", "advisory", "skipped"] },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "backend", "identity", "timestamp"],
      "properties": {
        "status": {
          "enum": ["verified", "failed", "unavailable", "skipped"]
        },
        "reason": { "type": ["string", "null"] },
        "backend": { "enum": ["ssh", "openpgp", null] },
        "identity": {
          "oneOf": [
            { "const": null },
            { "$ref": "#/$defs/sshIdentity" },
            { "$ref": "#/$defs/openPgpIdentity" }
          ]
        },
        "timestamp": { "type": "string", "minLength": 20 }
      },
      "oneOf": [
        {
          "properties": {
            "status": { "const": "verified" },
            "backend": { "const": "ssh" },
            "identity": { "$ref": "#/$defs/sshIdentity" }
          }
        },
        {
          "properties": {
            "status": { "const": "verified" },
            "backend": { "const": "openpgp" },
            "identity": { "$ref": "#/$defs/openPgpIdentity" }
          }
        },
        {
          "properties": {
            "status": { "enum": ["failed", "unavailable"] },
            "identity": { "const": null }
          }
        },
        {
          "properties": {
            "status": { "const": "skipped" },
            "backend": { "const": null },
            "identity": { "const": null }
          }
        }
      ]
    },
    "sshIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal", "keyFingerprint"],
      "properties": {
        "principal": { "type": "string", "minLength": 1 },
        "keyFingerprint": {
          "type": "string",
          "pattern": "^SHA256:[A-Za-z0-9+/=_-]+$"
        }
      }
    },
    "openPgpIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signer",
        "primaryKeyFingerprint",
        "signingSubkeyFingerprint"
      ],
      "properties": {
        "signer": { "type": "string", "minLength": 1 },
        "primaryKeyFingerprint": {
          "type": "string",
          "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        },
        "signingSubkeyFingerprint": {
          "type": ["string", "null"],
          "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        }
      }
    }
  }
}
