{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inline Evidence Capsule",
  "description": "Complete bounded evidence returned directly by a concise commit preparation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestSha256",
    "evidencePlanSha256",
    "changeUnitCount",
    "scopeSynopsis",
    "evidence",
    "unresolved",
    "byteCount"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestSha256": { "$ref": "#/$defs/sha256" },
    "evidencePlanSha256": { "$ref": "#/$defs/sha256" },
    "changeUnitCount": { "type": "integer", "minimum": 1 },
    "scopeSynopsis": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "unresolved": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "string" }
    },
    "byteCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32768
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "selectionSummary",
        "basisKind",
        "basisNote",
        "patchText",
        "patchComplete"
      ],
      "properties": {
        "policy": { "enum": ["reuse", "message"] },
        "selectionSummary": { "type": "string", "minLength": 1 },
        "basisKind": {
          "enum": [
            "authored-current-task",
            "read-current-task",
            "task-lineage",
            "user-grounded",
            "generated-derived"
          ]
        },
        "basisNote": { "type": ["string", "null"], "maxLength": 512 },
        "patchText": { "type": ["string", "null"] },
        "patchComplete": { "const": true }
      },
      "oneOf": [
        {
          "properties": {
            "policy": { "const": "reuse" },
            "patchText": { "const": null }
          }
        },
        {
          "properties": {
            "policy": { "const": "message" },
            "patchText": { "type": "string" }
          }
        }
      ]
    }
  }
}
