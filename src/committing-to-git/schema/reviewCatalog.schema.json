{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review Catalog",
  "description": "Immutable packet identities and compact manifest-range requirements for extended review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "indexTreeOid",
    "manifestSha256",
    "evidencePlanSha256",
    "evidenceGroups",
    "inlineCoverage",
    "packets",
    "requiredSynopsisPacketIds",
    "exactInventoryPacketIds",
    "fullPatchPacketIds",
    "deletions",
    "storage",
    "catalogSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "indexTreeOid": { "$ref": "#/$defs/objectId" },
    "manifestSha256": { "$ref": "#/$defs/sha256" },
    "evidencePlanSha256": { "$ref": "#/$defs/sha256" },
    "evidenceGroups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceGroup" }
    },
    "inlineCoverage": { "$ref": "#/$defs/inlineCoverage" },
    "packets": {
      "type": "array",
      "items": { "$ref": "#/$defs/packet" }
    },
    "requiredSynopsisPacketIds": { "$ref": "#/$defs/packetIds" },
    "exactInventoryPacketIds": { "$ref": "#/$defs/packetIds" },
    "fullPatchPacketIds": { "$ref": "#/$defs/packetIds" },
    "deletions": {
      "type": "array",
      "items": { "$ref": "#/$defs/deletion" }
    },
    "storage": { "$ref": "#/$defs/storage" },
    "catalogSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "objectId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "changeUnitId": {
      "type": "string",
      "pattern": "^F[0-9]{6}$"
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first", "last"],
      "properties": {
        "first": { "$ref": "#/$defs/changeUnitId" },
        "last": { "$ref": "#/$defs/changeUnitId" }
      }
    },
    "ranges": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/range" }
    },
    "packetIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[SIPD][0-9]{6}$"
      }
    },
    "evidenceGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "policy",
        "changeUnitRanges",
        "changeUnitCount",
        "requiredTextPatchRanges",
        "requiredTextPatchCount"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^E[0-9]{6}$" },
        "policy": { "enum": ["reuse", "message", "review"] },
        "changeUnitRanges": { "$ref": "#/$defs/ranges" },
        "changeUnitCount": { "type": "integer", "minimum": 1 },
        "requiredTextPatchRanges": {
          "type": "array",
          "items": { "$ref": "#/$defs/range" }
        },
        "requiredTextPatchCount": { "type": "integer", "minimum": 0 }
      }
    },
    "inlineCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeSynopsis", "evidenceGroupIds"],
      "properties": {
        "scopeSynopsis": { "type": "boolean" },
        "evidenceGroupIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^E[0-9]{6}$" }
        }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "artifact",
        "byteCount",
        "lineCount",
        "sha256",
        "rawArtifact",
        "rawByteStart",
        "rawByteEnd",
        "rawByteCount",
        "rawSha256",
        "encoding",
        "changeUnitRanges",
        "changeUnitCount"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[SIPD][0-9]{6}$" },
        "kind": {
          "enum": [
            "scope-synopsis",
            "exact-inventory",
            "text-patch",
            "deleted-content"
          ]
        },
        "artifact": {
          "type": "string",
          "pattern": "^packets/[0-9a-f]{64}\\.packet$"
        },
        "byteCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "lineCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "rawArtifact": {
          "type": "string",
          "pattern": "^raw/[0-9a-f]{64}\\.bin$"
        },
        "rawByteStart": { "type": "integer", "minimum": 0 },
        "rawByteEnd": { "type": "integer", "minimum": 0 },
        "rawByteCount": { "type": "integer", "minimum": 0 },
        "rawSha256": { "$ref": "#/$defs/sha256" },
        "encoding": { "enum": ["utf-8", "escaped-hex"] },
        "changeUnitRanges": { "$ref": "#/$defs/ranges" },
        "changeUnitCount": { "type": "integer", "minimum": 1 },
        "evidenceGroupIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^E[0-9]{6}$" }
        }
      }
    },
    "deletion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changeUnitId",
        "oldOid",
        "byteCount",
        "sha256",
        "packetIds"
      ],
      "properties": {
        "changeUnitId": { "$ref": "#/$defs/changeUnitId" },
        "oldOid": { "$ref": "#/$defs/objectId" },
        "byteCount": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "packetIds": { "$ref": "#/$defs/packetIds" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "baseIndexArtifact",
        "baseIndexSha256",
        "revisionCount",
        "currentRevisionArtifact"
      ],
      "properties": {
        "kind": { "const": "base-plus-revisions" },
        "baseIndexArtifact": { "const": "base-packet-index.json" },
        "baseIndexSha256": { "$ref": "#/$defs/sha256" },
        "revisionCount": { "type": "integer", "minimum": 0 },
        "currentRevisionArtifact": { "type": ["string", "null"] }
      }
    }
  }
}
