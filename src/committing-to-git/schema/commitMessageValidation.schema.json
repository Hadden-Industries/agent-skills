{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commit Message Validation Result",
  "description": "Structured result of validating a commit message against its approved snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "valid",
    "manualReviewRequired",
    "canonical",
    "mode",
    "inspection",
    "scope",
    "manifest",
    "subject",
    "sections",
    "files",
    "summary",
    "issues"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "valid": {
      "type": "boolean"
    },
    "manualReviewRequired": {
      "type": "boolean"
    },
    "canonical": {
      "type": ["boolean", "null"]
    },
    "mode": {
      "enum": ["detailed", "bulk", "legacy"]
    },
    "inspection": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["complete", "treeMatches"],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "treeMatches": {
          "type": "boolean"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "resolved", "indexTreeOid"],
      "properties": {
        "requested": {
          "enum": ["auto", "staged", "worktree", "manifest"]
        },
        "resolved": {
          "enum": ["staged", "worktree", "snapshot"]
        },
        "indexTreeOid": {
          "type": ["string", "null"]
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "indexTreeOid"],
      "properties": {
        "schemaVersion": {
          "type": ["integer", "null"]
        },
        "indexTreeOid": {
          "type": ["string", "null"]
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "scope", "length", "target", "maximum"],
      "properties": {
        "type": {
          "enum": [
            null,
            "build",
            "ci",
            "docs",
            "feat",
            "fix",
            "perf",
            "refactor",
            "test"
          ]
        },
        "scope": {
          "type": ["string", "null"]
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "target": {
          "const": 50
        },
        "maximum": {
          "const": 72
        }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rationale", "userExperience", "fileChanges"],
      "properties": {
        "rationale": {
          "$ref": "#/$defs/sectionStatus"
        },
        "userExperience": {
          "$ref": "#/$defs/sectionStatus"
        },
        "fileChanges": {
          "$ref": "#/$defs/sectionStatus"
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedCount",
        "listedCount",
        "setMatches",
        "orderValid",
        "unique"
      ],
      "properties": {
        "expectedCount": {
          "type": "integer",
          "minimum": 0
        },
        "listedCount": {
          "type": "integer",
          "minimum": 0
        },
        "setMatches": {
          "type": "boolean"
        },
        "orderValid": {
          "type": "boolean"
        },
        "unique": {
          "type": "boolean"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errors", "reviews"],
      "properties": {
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "reviews": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "$defs": {
    "sectionStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "structureValid"],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "structureValid": {
          "type": "boolean"
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": {
          "enum": ["error", "review"]
        },
        "code": {
          "enum": [
            "SUBJECT_FORMAT_INVALID",
            "SUBJECT_TYPE_NOT_ALLOWED",
            "SUBJECT_DESCRIPTION_NOT_CAPITALIZED",
            "SUBJECT_TRAILING_PERIOD",
            "SUBJECT_TOO_LONG",
            "SECTION_SPACING_INVALID",
            "SECTION_ORDER_INVALID",
            "UNEXPECTED_BLANK_LINE",
            "UX_SECTION_DUPLICATE",
            "UX_SECTION_EMPTY",
            "UX_ENTRY_FORMAT_INVALID",
            "FILE_SECTION_MISSING",
            "FILE_SECTION_DUPLICATE",
            "FILE_SECTION_EMPTY",
            "FILE_ENTRY_FORMAT_INVALID",
            "FILE_ENTRY_NUMBERING_INVALID",
            "FILE_ENTRY_MISSING_CHANGE",
            "FILE_DUPLICATE",
            "FILE_ORDER_INVALID",
            "FILE_MISSING_FROM_MESSAGE",
            "FILE_NOT_CURRENTLY_CHANGED",
            "MESSAGE_NOT_CANONICAL",
            "INSPECTION_INCOMPLETE",
            "BODY_LINE_OVER_LIMIT"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
