{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commit Message Validation Result",
  "description": "Exact validation for canonical workflow messages, with the pre-cutover validator result retained until the legacy routes are removed.",
  "oneOf": [
    { "$ref": "#/$defs/approvedResult" },
    { "$ref": "#/$defs/legacyResult" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approvedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "valid",
        "route",
        "messageSource",
        "byteCount",
        "messageSha256",
        "displayText",
        "subject",
        "sections",
        "files",
        "presentationWarnings"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "valid": { "const": true },
        "route": { "enum": ["concise", "extended"] },
        "messageSource": {
          "enum": ["approved-subject", "checked-file", "structured-finalizer"]
        },
        "byteCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "messageSha256": { "$ref": "#/$defs/sha256" },
        "displayText": { "type": "string", "minLength": 1 },
        "subject": { "$ref": "#/$defs/approvedSubject" },
        "sections": { "$ref": "#/$defs/approvedSections" },
        "files": { "$ref": "#/$defs/files" },
        "presentationWarnings": { "$ref": "#/$defs/presentationWarnings" }
      },
      "oneOf": [
        {
          "properties": {
            "route": { "const": "extended" },
            "messageSource": { "const": "structured-finalizer" }
          }
        },
        {
          "properties": {
            "route": { "const": "concise" },
            "messageSource": {
              "enum": ["approved-subject", "checked-file"]
            }
          }
        }
      ]
    },
    "approvedSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "type", "scope", "description", "scalarLength"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "scope": { "type": ["string", "null"] },
        "description": { "type": "string", "minLength": 1 },
        "scalarLength": { "type": "integer", "minimum": 1, "maximum": 72 }
      }
    },
    "approvedSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "entryCount"],
      "properties": {
        "present": { "type": "boolean" },
        "entryCount": { "type": "integer", "minimum": 0 }
      }
    },
    "approvedSections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rationale", "userExperience", "fileChanges"],
      "properties": {
        "rationale": { "$ref": "#/$defs/approvedSection" },
        "userExperience": { "$ref": "#/$defs/approvedSection" },
        "fileChanges": { "$ref": "#/$defs/approvedSection" }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedCount",
        "listedCount",
        "setMatches",
        "orderValid",
        "unique"
      ],
      "properties": {
        "expectedCount": { "type": "integer", "minimum": 0 },
        "listedCount": { "type": "integer", "minimum": 0 },
        "setMatches": { "type": "boolean" },
        "orderValid": { "type": "boolean" },
        "unique": { "type": "boolean" }
      }
    },
    "presentationWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineNumber", "scalarLength", "reason"],
      "properties": {
        "lineNumber": { "type": "integer", "minimum": 2 },
        "scalarLength": { "type": "integer", "minimum": 73 },
        "reason": { "enum": ["formatted-path-identity", "indivisible-token"] }
      }
    },
    "presentationWarnings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "samples", "sha256"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "samples": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/presentationWarning" }
        },
        "sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "const": null }]
        }
      },
      "oneOf": [
        {
          "properties": {
            "count": { "const": 0 },
            "samples": { "maxItems": 0 },
            "sha256": { "const": null }
          }
        },
        {
          "properties": {
            "count": { "type": "integer", "minimum": 1 },
            "samples": { "minItems": 1 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "legacyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "valid",
        "manualReviewRequired",
        "canonical",
        "mode",
        "inspection",
        "scope",
        "manifest",
        "subject",
        "sections",
        "files",
        "summary",
        "issues"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "valid": { "type": "boolean" },
        "manualReviewRequired": { "type": "boolean" },
        "canonical": { "type": ["boolean", "null"] },
        "mode": { "enum": ["detailed", "bulk", "legacy"] },
        "inspection": { "type": ["object", "null"] },
        "scope": { "type": "object" },
        "manifest": { "type": "object" },
        "subject": { "type": "object" },
        "sections": { "type": "object" },
        "files": { "$ref": "#/$defs/files" },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["errors", "reviews"],
          "properties": {
            "errors": { "type": "integer", "minimum": 0 },
            "reviews": { "type": "integer", "minimum": 0 }
          }
        },
        "issues": {
          "type": "array",
          "items": { "$ref": "#/$defs/issue" }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "enum": ["error", "review"] },
        "code": {
          "enum": [
            "SUBJECT_FORMAT_INVALID",
            "SUBJECT_DESCRIPTION_NOT_CAPITALIZED",
            "SUBJECT_TRAILING_PERIOD",
            "SUBJECT_TOO_LONG",
            "SECTION_SPACING_INVALID",
            "SECTION_ORDER_INVALID",
            "UNEXPECTED_BLANK_LINE",
            "UX_SECTION_DUPLICATE",
            "UX_SECTION_EMPTY",
            "UX_ENTRY_FORMAT_INVALID",
            "FILE_SECTION_MISSING",
            "FILE_SECTION_DUPLICATE",
            "FILE_SECTION_EMPTY",
            "FILE_ENTRY_FORMAT_INVALID",
            "FILE_ENTRY_NUMBERING_INVALID",
            "FILE_ENTRY_MISSING_CHANGE",
            "FILE_DUPLICATE",
            "FILE_ORDER_INVALID",
            "FILE_MISSING_FROM_MESSAGE",
            "FILE_NOT_CURRENTLY_CHANGED",
            "MESSAGE_NOT_CANONICAL",
            "INSPECTION_INCOMPLETE",
            "BODY_LINE_OVER_LIMIT"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    }
  }
}
