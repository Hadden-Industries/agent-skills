{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commit Transaction",
  "description": "Durable state and bounded artifact references for one commit workflow attempt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phase",
    "repositoryRoot",
    "attemptDirectory",
    "mode",
    "status",
    "terminalDisposition",
    "scope",
    "headAnchor",
    "repositoryTypePolicy",
    "initialEvidencePlan",
    "route",
    "verificationPolicy",
    "signaturePreflight",
    "snapshot",
    "inlineEvidence",
    "review",
    "message",
    "commit",
    "verification",
    "report",
    "checkAttempts",
    "publicationAttempts"
  ],
  "properties": {
    "schemaVersion": { "const": 4 },
    "phase": {
      "enum": [
        "allocated",
        "snapshot-created",
        "evidence-ready",
        "review-pending",
        "authoring-pending",
        "message-ready",
        "commit-pending",
        "reported",
        "publication-pending",
        "published",
        "stopped",
        "abandoned",
        "superseded"
      ]
    },
    "repositoryRoot": { "type": "string", "minLength": 1 },
    "attemptDirectory": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["actual", "draft", null] },
    "status": {
      "enum": [
        "prepared",
        "review-pending",
        "authoring-pending",
        "message-ready",
        "evidence-required",
        "promoted",
        "reported",
        "published",
        "commit-blocked",
        "outcome-unknown",
        "recovered",
        "cleaned",
        "stopped",
        "invalid",
        null
      ]
    },
    "terminalDisposition": {
      "enum": [
        "no-commit-stopped",
        "local-commit-recorded",
        "published",
        "abandoned",
        "superseded",
        null
      ]
    },
    "scope": { "type": ["object", "null"] },
    "headAnchor": { "$ref": "#/$defs/nullableHeadAnchor" },
    "repositoryTypePolicy": { "$ref": "#/$defs/repositoryTypePolicy" },
    "initialEvidencePlan": { "type": ["object", "null"] },
    "route": { "enum": ["concise", "extended", null] },
    "verificationPolicy": { "enum": ["required", "advisory", "skipped"] },
    "signaturePreflight": { "$ref": "#/$defs/signaturePreflight" },
    "snapshot": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "promotion": { "$ref": "#/$defs/nullablePromotionState" }
          }
        }
      ]
    },
    "inlineEvidence": { "$ref": "#/$defs/inlineEvidenceState" },
    "review": { "$ref": "#/$defs/reviewState" },
    "message": { "$ref": "#/$defs/messageState" },
    "commit": { "$ref": "#/$defs/commitJournal" },
    "verification": { "$ref": "#/$defs/verificationHistory" },
    "report": { "$ref": "#/$defs/reportState" },
    "checkAttempts": {
      "type": "array",
      "items": { "$ref": "#/$defs/checkAttempt" }
    },
    "publicationAttempts": {
      "type": "array",
      "items": { "$ref": "#/$defs/publicationAttempt" }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/allocatedState" },
    { "$ref": "#/$defs/snapshotCreatedState" },
    { "$ref": "#/$defs/evidencePreparedState" },
    { "$ref": "#/$defs/evidencePromotedState" },
    { "$ref": "#/$defs/reviewPendingState" },
    { "$ref": "#/$defs/evidenceRequiredState" },
    { "$ref": "#/$defs/authoringPendingState" },
    { "$ref": "#/$defs/authoringPromotedState" },
    { "$ref": "#/$defs/messageReadyState" },
    { "$ref": "#/$defs/messagePromotedState" },
    { "$ref": "#/$defs/commitPendingState" },
    { "$ref": "#/$defs/reportedState" },
    { "$ref": "#/$defs/commitBlockedState" },
    { "$ref": "#/$defs/reportedRecoveredState" },
    { "$ref": "#/$defs/publicationPendingState" },
    { "$ref": "#/$defs/publishedState" },
    { "$ref": "#/$defs/publishedRecoveredState" },
    { "$ref": "#/$defs/stoppedState" },
    { "$ref": "#/$defs/invalidState" },
    { "$ref": "#/$defs/stoppedCleanedState" },
    { "$ref": "#/$defs/stoppedRecoveredState" },
    { "$ref": "#/$defs/abandonedState" },
    { "$ref": "#/$defs/abandonedCleanedState" },
    { "$ref": "#/$defs/supersededState" },
    { "$ref": "#/$defs/supersededCleanedState" }
  ],
  "$defs": {
    "indexFileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "inode",
        "mode",
        "modifiedTimeMilliseconds",
        "changeTimeMilliseconds"
      ],
      "properties": {
        "device": { "type": "string", "minLength": 1 },
        "inode": { "type": "string", "minLength": 1 },
        "mode": { "type": "integer", "minimum": 0 },
        "modifiedTimeMilliseconds": { "type": "number", "minimum": 0 },
        "changeTimeMilliseconds": { "type": "number", "minimum": 0 }
      }
    },
    "indexIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": { "state": { "const": "absent" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "byteCount", "sha256", "fileIdentity"],
          "properties": {
            "state": { "const": "file" },
            "byteCount": { "type": "integer", "minimum": 0 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "fileIdentity": { "$ref": "#/$defs/indexFileIdentity" }
          }
        }
      ]
    },
    "promotionRecoveryObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "resumeAllowed",
        "recoveryRequired",
        "currentIndexIdentity",
        "preparedIndexTreeOid",
        "headAnchor"
      ],
      "properties": {
        "status": {
          "enum": [
            "installed",
            "matching-index-observed",
            "not-installed",
            "ambiguous"
          ]
        },
        "resumeAllowed": { "type": "boolean" },
        "recoveryRequired": { "type": "boolean" },
        "currentIndexIdentity": { "$ref": "#/$defs/indexIdentity" },
        "preparedIndexTreeOid": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "headAnchor": {
          "allOf": [
            { "$ref": "#/$defs/nullableHeadAnchor" },
            { "type": "object" }
          ]
        }
      }
    },
    "promotionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "status",
        "headAnchor",
        "indexTreeOid",
        "originalIndexIdentity",
        "preparedIndexPath",
        "preparedIndexIdentity",
        "installedIndexIdentity",
        "recoveryObservation"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "status": { "enum": ["prepared", "recovery-observed", "installed"] },
        "headAnchor": {
          "allOf": [
            { "$ref": "#/$defs/nullableHeadAnchor" },
            { "type": "object" }
          ]
        },
        "indexTreeOid": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "originalIndexIdentity": { "$ref": "#/$defs/indexIdentity" },
        "preparedIndexPath": { "type": ["string", "null"] },
        "preparedIndexIdentity": { "$ref": "#/$defs/indexIdentity" },
        "installedIndexIdentity": {
          "oneOf": [{ "$ref": "#/$defs/indexIdentity" }, { "type": "null" }]
        },
        "recoveryObservation": {
          "oneOf": [
            { "$ref": "#/$defs/promotionRecoveryObservation" },
            { "type": "null" }
          ]
        }
      }
    },
    "nullablePromotionState": {
      "oneOf": [{ "$ref": "#/$defs/promotionState" }, { "type": "null" }]
    },
    "publicationAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "attemptId",
        "retryOf",
        "status",
        "launchState",
        "childIdentity",
        "commitOid",
        "remote",
        "destination",
        "refspec",
        "startedAt",
        "completion",
        "transcript",
        "observation",
        "resolution",
        "retryPermitted",
        "reason"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "attemptId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "retryOf": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            { "type": "null" }
          ]
        },
        "status": {
          "enum": [
            "pending",
            "unknown",
            "rejected",
            "succeeded",
            "observed-matching"
          ]
        },
        "launchState": {
          "enum": ["not-started", "launching", "running", "completed"]
        },
        "childIdentity": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["pid", "startIdentity"],
              "properties": {
                "pid": { "type": "integer", "minimum": 1 },
                "startIdentity": { "type": ["string", "null"] }
              }
            },
            { "type": "null" }
          ]
        },
        "commitOid": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "remote": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "destination": {
          "type": "string",
          "pattern": "^refs/heads/[^\\u0000-\\u001f\\u007f]+$"
        },
        "refspec": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "minLength": 1 },
        "completion": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "exitCode",
                "signal",
                "transcriptCompletionSha256",
                "nonLaunchGuaranteed",
                "launchError",
                "outcome"
              ],
              "properties": {
                "exitCode": { "type": ["integer", "null"] },
                "signal": { "type": ["string", "null"] },
                "transcriptCompletionSha256": {
                  "type": ["string", "null"],
                  "pattern": "^[0-9a-f]{64}$"
                },
                "nonLaunchGuaranteed": { "type": "boolean" },
                "launchError": { "type": ["object", "null"] },
                "outcome": {
                  "enum": [
                    "not-launched",
                    "witnessed-success",
                    "known-rejection",
                    "unknown"
                  ]
                }
              }
            },
            { "type": "null" }
          ]
        },
        "transcript": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "status",
                "signal",
                "totalByteCount",
                "stdoutByteCount",
                "stderrByteCount",
                "stdoutSha256",
                "stderrSha256",
                "sha256",
                "completionSha256",
                "retainRecommended"
              ],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "status": { "type": ["integer", "null"] },
                "signal": { "type": ["string", "null"] },
                "totalByteCount": { "type": "integer", "minimum": 0 },
                "stdoutByteCount": { "type": "integer", "minimum": 0 },
                "stderrByteCount": { "type": "integer", "minimum": 0 },
                "stdoutSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "stderrSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "completionSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "retainRecommended": { "type": "boolean" }
              }
            },
            { "type": "null" }
          ]
        },
        "observation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "observedAt",
                "observedOid",
                "exitCode",
                "stdoutSha256",
                "stderrSha256",
                "commandDigest",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": ["querying", "observed", "absent", "unavailable"]
                },
                "observedAt": { "type": "string", "minLength": 1 },
                "observedOid": {
                  "type": ["string", "null"],
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                },
                "exitCode": { "type": ["integer", "null"] },
                "stdoutSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "stderrSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "commandDigest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "reason": { "type": ["string", "null"] }
              }
            },
            { "type": "null" }
          ]
        },
        "resolution": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "assertedAt", "observationDigest"],
              "properties": {
                "kind": { "const": "confirmed-no-live-child" },
                "assertedAt": { "type": "string", "minLength": 1 },
                "observationDigest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            { "type": "null" }
          ]
        },
        "retryPermitted": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      }
    },
    "nullableHeadAnchor": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["headKind", "targetRef", "expectedParentOids"],
      "properties": {
        "headKind": { "enum": ["unborn", "attached", "detached"] },
        "targetRef": { "type": ["string", "null"] },
        "expectedParentOids": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          }
        }
      },
      "oneOf": [
        { "const": null },
        {
          "type": "object",
          "properties": {
            "headKind": { "const": "unborn" },
            "targetRef": {
              "type": "string",
              "pattern": "^refs/heads/[^\\u0000]+$"
            },
            "expectedParentOids": {
              "type": "array",
              "minItems": 0,
              "maxItems": 0
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "headKind": { "const": "attached" },
            "targetRef": {
              "type": "string",
              "pattern": "^refs/heads/[^\\u0000]+$"
            },
            "expectedParentOids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "headKind": { "const": "detached" },
            "targetRef": { "const": null },
            "expectedParentOids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1
            }
          }
        }
      ]
    },
    "repositoryTypePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedTypes"],
      "properties": {
        "allowedTypes": {
          "type": ["array", "null"],
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          }
        }
      }
    },
    "inlineEvidenceState": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "capsuleSha256",
        "manifestSha256",
        "evidencePlanSha256",
        "capsule"
      ],
      "properties": {
        "capsuleSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidencePlanSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capsule": { "type": "object" }
      }
    },
    "reviewState": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "catalogPath",
        "catalogSha256",
        "evidencePlanPath",
        "evidencePlanSha256",
        "extendedReason",
        "deliveryPacketIds",
        "queue",
        "receipt",
        "semanticStructureRequired",
        "structuredMessageMode",
        "traversal"
      ],
      "properties": {
        "catalogPath": { "type": "string", "minLength": 1 },
        "catalogSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidencePlanPath": { "type": "string", "minLength": 1 },
        "evidencePlanSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "coveredCapsuleSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "extendedReason": {
          "enum": [
            "review-policy",
            "required-evidence-over-budget",
            "scope-synopsis-over-budget",
            "invalid-evidence-encoding",
            "required-object-unavailable",
            "unresolved-anomaly",
            "evidence-uncertainty",
            "semantic-structure-required"
          ]
        },
        "deliveryPacketIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[SIPD][0-9]{6}$"
          }
        },
        "queue": { "type": ["object", "null"] },
        "receipt": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schemaVersion",
                "catalogSha256",
                "evidencePlanSha256",
                "requiredPacketsReviewed",
                "additionalPacketIds"
              ],
              "properties": {
                "schemaVersion": { "const": 1 },
                "catalogSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "evidencePlanSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "requiredPacketsReviewed": { "const": true },
                "additionalPacketIds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[SIPD][0-9]{6}$"
                  }
                }
              }
            }
          ]
        },
        "semanticStructureRequired": { "type": "boolean" },
        "structuredMessageMode": { "enum": ["detailed", "bulk"] },
        "traversal": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schemaVersion",
                "catalogSha256",
                "deliveredPacketCount",
                "lastRequestCursor",
                "nextCursor",
                "complete"
              ],
              "properties": {
                "schemaVersion": { "const": 1 },
                "catalogSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "deliveredPacketCount": {
                  "type": "integer",
                  "minimum": 1
                },
                "lastRequestCursor": {
                  "type": ["string", "null"],
                  "pattern": "^review-v1-[0-9a-f]{64}$"
                },
                "nextCursor": {
                  "type": ["string", "null"],
                  "pattern": "^review-v1-[0-9a-f]{64}$"
                },
                "complete": { "type": "boolean" }
              }
            }
          ]
        }
      }
    },
    "messageState": {
      "oneOf": [
        { "const": null },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "revision",
            "sha256",
            "source",
            "byteCount",
            "stateSha256",
            "validationSha256",
            "slot"
          ],
          "properties": {
            "schemaVersion": { "const": 1 },
            "revision": { "type": "integer", "minimum": 1 },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "source": {
              "enum": ["approved-subject", "checked-file", "finalized-extended"]
            },
            "byteCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32768
            },
            "stateSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "validationSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "slot": { "const": "message/current" }
          }
        }
      ]
    },
    "signaturePreflight": {
      "oneOf": [
        { "const": null },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend", "trustSource"],
          "properties": {
            "backend": { "enum": ["openpgp", null] },
            "trustSource": { "const": null }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend", "trustSource"],
          "properties": {
            "backend": { "const": "ssh" },
            "trustSource": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "configured",
                "origin",
                "path",
                "state",
                "errorCode"
              ],
              "properties": {
                "configured": { "type": "boolean" },
                "origin": { "type": ["string", "null"] },
                "path": { "type": ["string", "null"] },
                "state": {
                  "enum": [
                    "readable",
                    "not-configured",
                    "not-found",
                    "permission-denied",
                    "invalid-file-type",
                    "probe-error"
                  ]
                },
                "errorCode": { "type": ["string", "null"] }
              }
            }
          }
        }
      ]
    },
    "checkAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "receiptId",
        "retryOf",
        "label",
        "command",
        "context",
        "subject",
        "launchState",
        "childIdentity",
        "startedAt",
        "completion",
        "workspace",
        "output",
        "resolution"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "receiptId": { "type": "string", "pattern": "^C[0-9]{6}$" },
        "retryOf": {
          "type": ["string", "null"],
          "pattern": "^C[0-9]{6}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        "command": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executable", "arguments"],
          "properties": {
            "executable": { "type": "string", "minLength": 1 },
            "arguments": {
              "type": "array",
              "maxItems": 256,
              "items": { "type": "string" }
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repositoryRelativeWorkingDirectory"],
          "properties": {
            "kind": { "const": "current-worktree" },
            "repositoryRelativeWorkingDirectory": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifestSha256", "headAnchor", "preparedTreeOid"],
          "properties": {
            "manifestSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "headAnchor": { "$ref": "#/$defs/nullableHeadAnchor" },
            "preparedTreeOid": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            }
          }
        },
        "launchState": { "enum": ["launching", "running", "completed"] },
        "childIdentity": {
          "oneOf": [
            { "const": null },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["pid", "startIdentity"],
              "properties": {
                "pid": { "type": "integer", "minimum": 1 },
                "startIdentity": { "type": ["string", "null"] }
              }
            }
          ]
        },
        "startedAt": { "type": "string", "minLength": 20 },
        "completion": {
          "oneOf": [
            { "const": null },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "finishedAt",
                "durationMilliseconds",
                "outcome",
                "exitCode",
                "signal",
                "launchError"
              ],
              "properties": {
                "finishedAt": { "type": "string", "minLength": 20 },
                "durationMilliseconds": { "type": "integer", "minimum": 0 },
                "outcome": {
                  "enum": [
                    "passed",
                    "failed",
                    "launch-error",
                    "signaled",
                    "timed-out",
                    "unknown"
                  ]
                },
                "exitCode": { "type": ["integer", "null"] },
                "signal": { "type": ["string", "null"] },
                "launchError": { "type": ["object", "null"] }
              }
            }
          ]
        },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before", "after"],
          "properties": {
            "before": { "$ref": "#/$defs/checkWorkspaceObservation" },
            "after": {
              "oneOf": [
                { "const": null },
                { "$ref": "#/$defs/checkWorkspaceObservation" }
              ]
            }
          }
        },
        "output": {
          "oneOf": [
            { "const": null },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["schemaVersion", "stdout", "stderr"],
              "properties": {
                "schemaVersion": { "const": 1 },
                "stdout": { "$ref": "#/$defs/checkOutputChannel" },
                "stderr": { "$ref": "#/$defs/checkOutputChannel" }
              }
            }
          ]
        },
        "resolution": {
          "oneOf": [
            { "const": null },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "resolvedAt"],
              "properties": {
                "kind": { "const": "confirmed-no-live-child" },
                "resolvedAt": { "type": "string", "minLength": 20 }
              }
            }
          ]
        }
      }
    },
    "checkWorkspaceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matches", "pathCount", "observedAt"],
      "properties": {
        "matches": { "type": "boolean" },
        "pathCount": { "type": "integer", "minimum": 0 },
        "observedAt": { "type": "string", "minLength": 20 }
      }
    },
    "checkOutputChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalByteCount",
        "sha256",
        "headPath",
        "headByteCount",
        "headSha256",
        "tailPath",
        "tailByteCount",
        "tailSha256",
        "truncated"
      ],
      "properties": {
        "totalByteCount": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "headPath": { "type": ["string", "null"] },
        "headByteCount": { "type": "integer", "minimum": 0 },
        "headSha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "tailPath": { "type": ["string", "null"] },
        "tailByteCount": { "type": "integer", "minimum": 0 },
        "tailSha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "truncated": { "type": "boolean" }
      }
    },
    "commitJournal": {
      "oneOf": [
        { "const": null },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "launchState",
            "childIdentity",
            "headAnchor",
            "expectedTreeOid",
            "messageSha256",
            "messageByteCount",
            "acknowledgedFailedCheckIds",
            "startedAt",
            "completion",
            "transcript",
            "commitOid",
            "comparison",
            "observationProvenance",
            "recoveryObservations",
            "recoveryResolution"
          ],
          "properties": {
            "status": { "enum": ["pending", "created"] },
            "launchState": {
              "enum": ["not-started", "launching", "running", "completed"]
            },
            "childIdentity": {
              "oneOf": [
                { "const": null },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["pid", "startIdentity"],
                  "properties": {
                    "pid": { "type": "integer", "minimum": 1 },
                    "startIdentity": { "type": ["string", "null"] }
                  }
                }
              ]
            },
            "headAnchor": { "$ref": "#/$defs/nullableHeadAnchor" },
            "expectedTreeOid": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "messageSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "messageByteCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32768
            },
            "acknowledgedFailedCheckIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^C[0-9]{6}$"
              }
            },
            "startedAt": { "type": "string", "minLength": 20 },
            "completion": { "type": ["object", "null"] },
            "transcript": { "type": ["object", "null"] },
            "commitOid": {
              "type": ["string", "null"],
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "comparison": { "type": ["object", "null"] },
            "observationProvenance": {
              "enum": ["witnessed", "recovered", null]
            },
            "recoveryObservations": { "type": ["object", "null"] },
            "recoveryResolution": { "type": ["object", "null"] }
          }
        }
      ]
    },
    "verificationHistory": {
      "oneOf": [
        { "const": null },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "commitOid",
            "initialPolicy",
            "finalPolicy",
            "attempts",
            "effectiveAttempt",
            "blocksPush"
          ],
          "properties": {
            "schemaVersion": { "const": 2 },
            "commitOid": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "initialPolicy": {
              "enum": ["required", "advisory", "skipped"]
            },
            "finalPolicy": {
              "enum": ["required", "advisory", "skipped"]
            },
            "attempts": { "type": "array", "minItems": 1 },
            "effectiveAttempt": { "type": "integer", "minimum": 0 },
            "blocksPush": { "type": "boolean" }
          }
        }
      ]
    },
    "reportState": {
      "oneOf": [
        { "const": null },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "jsonPath",
            "jsonSha256",
            "textPath",
            "textSha256",
            "comparisonMatches",
            "publicationAllowed"
          ],
          "properties": {
            "schemaVersion": { "const": 1 },
            "jsonPath": { "type": "string", "minLength": 1 },
            "jsonSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "textPath": { "type": "string", "minLength": 1 },
            "textSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "comparisonMatches": { "type": "boolean" },
            "publicationAllowed": { "type": "boolean" }
          }
        }
      ]
    },
    "allocatedState": {
      "properties": {
        "phase": { "const": "allocated" },
        "status": { "const": null },
        "terminalDisposition": { "const": null },
        "message": { "const": null }
      }
    },
    "snapshotCreatedState": {
      "properties": {
        "phase": { "const": "snapshot-created" },
        "status": { "const": null },
        "terminalDisposition": { "const": null },
        "message": { "const": null }
      }
    },
    "evidencePreparedState": {
      "properties": {
        "phase": { "const": "evidence-ready" },
        "status": { "const": "prepared" },
        "terminalDisposition": { "const": null },
        "route": { "const": "concise" },
        "inlineEvidence": { "type": "object" },
        "review": { "const": null },
        "message": { "const": null }
      }
    },
    "evidencePromotedState": {
      "properties": {
        "phase": { "const": "evidence-ready" },
        "status": { "const": "promoted" },
        "mode": { "const": "actual" },
        "terminalDisposition": { "const": null },
        "route": { "const": "concise" },
        "inlineEvidence": { "type": "object" },
        "review": { "const": null },
        "message": { "const": null },
        "snapshot": {
          "type": "object",
          "required": ["promotion"],
          "properties": {
            "promotion": {
              "type": "object",
              "properties": { "status": { "const": "installed" } }
            }
          }
        }
      }
    },
    "reviewPendingState": {
      "properties": {
        "phase": { "const": "review-pending" },
        "status": { "const": "review-pending" },
        "terminalDisposition": { "const": null },
        "route": { "const": "extended" },
        "inlineEvidence": { "const": null },
        "review": {
          "type": "object",
          "properties": { "receipt": { "const": null } }
        }
      }
    },
    "evidenceRequiredState": {
      "properties": {
        "phase": { "const": "review-pending" },
        "status": { "const": "evidence-required" },
        "terminalDisposition": { "const": null },
        "route": { "const": "extended" },
        "inlineEvidence": { "const": null },
        "review": {
          "type": "object",
          "properties": { "receipt": { "const": null } }
        }
      }
    },
    "authoringPendingState": {
      "properties": {
        "phase": { "const": "authoring-pending" },
        "status": { "const": "authoring-pending" },
        "terminalDisposition": { "const": null },
        "route": { "const": "extended" },
        "inlineEvidence": { "const": null },
        "review": {
          "type": "object",
          "properties": {
            "receipt": {
              "type": "object",
              "properties": {
                "requiredPacketsReviewed": { "const": true }
              }
            }
          }
        },
        "message": { "type": ["object", "null"] }
      }
    },
    "authoringPromotedState": {
      "properties": {
        "phase": { "const": "authoring-pending" },
        "status": { "const": "promoted" },
        "mode": { "const": "actual" },
        "terminalDisposition": { "const": null },
        "route": { "const": "extended" },
        "inlineEvidence": { "const": null },
        "review": {
          "type": "object",
          "properties": {
            "receipt": {
              "type": "object",
              "properties": {
                "requiredPacketsReviewed": { "const": true }
              }
            }
          }
        },
        "message": { "type": ["object", "null"] },
        "snapshot": {
          "type": "object",
          "required": ["promotion"],
          "properties": {
            "promotion": {
              "type": "object",
              "properties": { "status": { "const": "installed" } }
            }
          }
        }
      }
    },
    "messageReadyState": {
      "properties": {
        "phase": { "const": "message-ready" },
        "status": { "const": "message-ready" },
        "terminalDisposition": { "const": null },
        "message": { "type": "object" }
      }
    },
    "messagePromotedState": {
      "properties": {
        "phase": { "const": "message-ready" },
        "status": { "const": "promoted" },
        "mode": { "const": "actual" },
        "terminalDisposition": { "const": null },
        "message": { "type": "object" },
        "snapshot": {
          "type": "object",
          "required": ["promotion"],
          "properties": {
            "promotion": {
              "type": "object",
              "properties": { "status": { "const": "installed" } }
            }
          }
        }
      }
    },
    "commitPendingState": {
      "properties": {
        "phase": { "const": "commit-pending" },
        "status": { "const": "outcome-unknown" },
        "terminalDisposition": { "const": null },
        "commit": { "type": "object" }
      }
    },
    "reportedState": {
      "properties": {
        "phase": { "const": "reported" },
        "status": { "const": "reported" },
        "terminalDisposition": { "const": "local-commit-recorded" },
        "commit": { "type": "object" },
        "verification": { "type": "object" },
        "report": { "type": "object" }
      }
    },
    "commitBlockedState": {
      "properties": {
        "phase": { "const": "reported" },
        "status": { "const": "commit-blocked" },
        "terminalDisposition": { "const": "local-commit-recorded" },
        "commit": { "type": "object" },
        "verification": { "type": "object" },
        "report": { "type": "object" }
      }
    },
    "reportedRecoveredState": {
      "properties": {
        "phase": { "const": "reported" },
        "status": { "const": "recovered" },
        "terminalDisposition": { "const": "local-commit-recorded" },
        "commit": { "type": "object" },
        "verification": { "type": "object" },
        "report": { "type": "object" }
      }
    },
    "publicationPendingState": {
      "properties": {
        "phase": { "const": "publication-pending" },
        "status": { "const": "outcome-unknown" },
        "terminalDisposition": { "const": null },
        "publicationAttempts": { "minItems": 1 }
      }
    },
    "publishedState": {
      "properties": {
        "phase": { "const": "published" },
        "status": { "const": "published" },
        "terminalDisposition": { "const": "published" },
        "publicationAttempts": { "minItems": 1 }
      }
    },
    "publishedRecoveredState": {
      "properties": {
        "phase": { "const": "published" },
        "status": { "const": "recovered" },
        "terminalDisposition": { "const": "published" },
        "publicationAttempts": { "minItems": 1 }
      }
    },
    "stoppedState": {
      "properties": {
        "phase": { "const": "stopped" },
        "status": { "const": "stopped" },
        "terminalDisposition": { "const": "no-commit-stopped" }
      }
    },
    "invalidState": {
      "properties": {
        "phase": { "const": "stopped" },
        "status": { "const": "invalid" },
        "terminalDisposition": { "const": "no-commit-stopped" }
      }
    },
    "stoppedCleanedState": {
      "properties": {
        "phase": { "const": "stopped" },
        "status": { "const": "cleaned" },
        "terminalDisposition": { "const": "no-commit-stopped" }
      }
    },
    "stoppedRecoveredState": {
      "properties": {
        "phase": { "const": "stopped" },
        "status": { "const": "recovered" },
        "terminalDisposition": { "const": "no-commit-stopped" }
      }
    },
    "abandonedState": {
      "properties": {
        "phase": { "const": "abandoned" },
        "status": { "const": "stopped" },
        "terminalDisposition": { "const": "abandoned" }
      }
    },
    "abandonedCleanedState": {
      "properties": {
        "phase": { "const": "abandoned" },
        "status": { "const": "cleaned" },
        "terminalDisposition": { "const": "abandoned" }
      }
    },
    "supersededState": {
      "properties": {
        "phase": { "const": "superseded" },
        "status": { "const": "stopped" },
        "terminalDisposition": { "const": "superseded" }
      }
    },
    "supersededCleanedState": {
      "properties": {
        "phase": { "const": "superseded" },
        "status": { "const": "cleaned" },
        "terminalDisposition": { "const": "superseded" }
      }
    }
  }
}
